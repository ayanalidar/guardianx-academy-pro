# next-auth@4 declares nodemailer as an OPTIONAL peer dependency, but npm's
# strict peer resolver still errors (ERESOLVE) when the root project installs
# nodemailer@10 outside next-auth's declared range - which broke Vercel
# production builds. Legacy resolution is semantically correct here: the peer
# is optional, the EmailProvider is unused, and nodemailer is used directly by
# src/lib/email.ts (SMTP transport).
legacy-peer-deps=true
