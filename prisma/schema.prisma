  xp          Int      @default(100)
  status      String   @default("available") // locked | available | in-progress | completed
  prerequisites String @default("[]") // JSON array of skill slugs
  relatedCourses String @default("[]") // JSON array of course IDs
  relatedLabs String   @default("[]") // JSON array of lab IDs
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Rank hierarchy — 8 tiers from Recruit to Elite Guardian
model Rank {
  id          String   @id @default(cuid())
  name        String   @unique // RECRUIT, ANALYST, HUNTER, OPERATOR, SPECIALIST, SENTINEL, GUARDIAN, ELITE_GUARDIAN
  displayName String   // "Recruit", "Analyst", etc.
  level       Int      @unique // 1-8
  xpThreshold Int      // XP needed to reach this rank
  color       String   @default("text-gray-400")
  description String?
  icon        String   @default("Shield")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Career roles — for career matching engine
/// (renamed from CareerRole → CareerPathRole to avoid collision with the
///  pre-existing CareerRole model used by /api/career/roles)
model CareerPathRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  icon        String   @default("Briefcase")
  color       String   @default("text-violet-300")
  // Skill weights as JSON: {"networking": 20, "linux": 20, "web": 25, "pentesting": 30, "reporting": 5}
  skillWeights String  @default("{}")
  minThreshold Int     @default(60) // minimum readiness % to be "ready"
  recommendedCerts String @default("[]") // JSON array of cert names
  recommendedCourses String @default("[]") // JSON array of course IDs
  recommendedLabs String @default("[]") // JSON array of lab IDs
  salaryRange String?
  demand      String   @default("High") // High | Medium | Low
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Platform statistics — admin-managed, optionally auto-calculated
model PlatformStat {
  id          String   @id @default(cuid())
  key         String   @unique // "learner_count", "lab_count", "course_count", "partner_count"
  label       String   // "Learners", "Labs", "Courses", "Partners"
  value       String   // "12000+" or calculated value
  source      String   @default("manual") // "manual" | "calculated"
  displayStatus String @default("visible") // visible | hidden
  suffix      String?  // "+", "", etc.
  icon        String   @default("Users")
  color       String   @default("text-violet-300")
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

/// Technology ecosystem — replaces fake "Trusted by Google" logos
model TechnologyPartner {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   @default("tool") // tool | platform | framework
  description String?
  url         String?
  icon        String   @default("Terminal")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// EXAM PLATFORM — Proctored examinations and GuardianX certs
// ============================================================

/// GuardianX certification — distinct from external certifications
model GuardianCertification {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  level       String   @default("Intermediate") // Beginner | Intermediate | Advanced | Expert
  domains     String   @default("[]") // JSON array of domain names
  skills      String   @default("[]") // JSON array of skills assessed
  examId      String?  // linked exam (legacy reference — Exam.certificationId is the canonical FK)
  passingScore Int     @default(70)
  validityPeriod Int   @default(36) // months
  icon        String   @default("Award")
  color       String   @default("text-violet-300")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credentials GuardianCredential[]
  exams       Exam[]
}

/// Exam blueprint — configurable exam template
model Exam {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  certificationId String? // linked GuardianCertification
  certification GuardianCertification? @relation(fields: [certificationId], references: [id])
  duration      Int      @default(120) // minutes
  passingScore  Int      @default(70)
  maxAttempts   Int      @default(3)
  questionCount Int      @default(50)
  sections      String   @default("[]") // JSON: [{title, questionCount, domains}]
  questionType  String   @default("mcq") // mcq | multiple | truefalse | scenario | practical | hybrid
  proctoringEnabled Boolean @default(true)
  shuffleQuestions Boolean @default(true)
  shuffleOptions  Boolean @default(true)
  status        String   @default("draft") // draft | published | archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attempts      ExamAttempt[]
  questions     QuestionBank[]
}

/// Question bank — tagged by domain, skill, difficulty
model QuestionBank {
  id            String   @id @default(cuid())
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id])
  type          String   @default("mcq") // mcq | multiple | truefalse | scenario | practical
  domain        String   // e.g. "Web Security", "Network Security", "GRC", "DFIR"
  skill         String?
  difficulty    String   @default("medium") // easy | medium | hard
  question      String
  options       String   @default("[]") // JSON array of option strings
  correctAnswer String   // JSON: index for mcq, array for multiple, "true"/"false" for boolean
  explanation   String?
  points        Int      @default(1)
  tags          String   @default("[]") // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Exam attempt — a learner's attempt at an exam
model ExamAttempt {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  userId        String
  status        String   @default("scheduled") // scheduled | in-progress | submitted | graded | passed | failed | voided
  startedAt     DateTime?
  submittedAt   DateTime?
  score         Int?     // percentage
  totalQuestions Int?
  correctAnswers Int?
  answers       String   @default("[]") // JSON: [{questionId, selected, correct}]
  proctorFlags  String   @default("[]") // JSON: [{type, timestamp, detail}]
  shuffleMap    String?  // JSON: { questionOrder: string[], optionOrder: { [questionId]: number[] } } — persisted on start so the submit route can map client-selected indices back to original option positions
  timeSpent     Int?     // seconds
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// GuardianX credential — issued when a learner passes an exam
model GuardianCredential {
  id              String   @id @default(cuid())
  credentialId    String   @unique // GX-CERT-YYYY-XXXX format
  userId          String
  certificationId String
  certification   GuardianCertification @relation(fields: [certificationId], references: [id])
  examAttemptId   String?
  candidateName   String
  score           Int
  skillsAssessed  String   @default("[]") // JSON array
  examType        String   @default("proctored")
  issueDate       DateTime @default(now())
  expiryDate      DateTime?
  status          String   @default("valid") // valid | expired | revoked | suspended
  verificationHash String  @unique
  verificationUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Proctoring session — records proctoring data for an exam attempt
model ProctoringSession {
  id            String   @id @default(cuid())
  examAttemptId String   @unique
  userId        String
  identityVerified Boolean @default(false)
  environmentChecked Boolean @default(false)
  cameraEnabled Boolean  @default(false)
  microphoneEnabled Boolean @default(false)
  screenShared  Boolean  @default(false)
  fullscreenMode Boolean @default(false)
  tabSwitches   Int      @default(0)
  windowBlurs   Int      @default(0)
  flags         String   @default("[]") // JSON: [{type, timestamp, severity, detail}]
  incidentCount Int      @default(0)
  recordingUrl  String?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
}

// ============================================================
// ADMIN-UPGRADE — Instructor Profile + Lead CRM models
// ============================================================

model InstructorProfile {
