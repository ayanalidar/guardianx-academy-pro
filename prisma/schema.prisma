// ============================================================
// TRAINING-BATCH-CRUD — public certification training batches
// (separate from the school-tied `Batch` model).
// ============================================================
model TrainingBatch {
  id              String   @id @default(cuid())
  certification   String   @default("")             // e.g. "CompTIA Security+", "CEH", "CCNA", "CISSP"
  name            String   @default("")             // e.g. "Security+ Weekend Batch"
  schedule        String   @default("")             // human-readable schedule
  startDate       String   @default("")             // e.g. "October 12" (display string)
  startIsoDate    String?                           // optional ISO date for sorting/filtering
  mode            String   @default("Live Online")  // "Live Online" | "On-Campus"
  instructor      String   @default("")             // instructor name
  instructorId    String?                           // optional link to User
  seats           Int      @default(20)             // total capacity
  enrolled        Int      @default(0)              // currently enrolled count
  level           String   @default("Beginner")     // "Beginner" | "Intermediate" | "Advanced"
  status          String   @default("Open")         // "Open" | "Almost Full" | "Full" | "Completed" | "Cancelled"
  certColor       String   @default("text-emerald-300")
  certTint        String   @default("bg-emerald-500/15")
  certBorder      String   @default("border-emerald-500/30")
  levelColor      String   @default("text-emerald-300")
  levelTint       String   @default("bg-emerald-500/10")
  levelBorder     String   @default("border-emerald-500/30")
  borderColor     String   @default("border-border/60")
  btnClass        String   @default("bg-emerald-600 hover:bg-emerald-500")
  description     String   @default("")             // optional longer description
  featured        Boolean  @default(false)          // show on homepage
  order           Int      @default(0)              // sort order
  published       Boolean  @default(true)
  googleFormUrl   String?                            // the Google Form URL for enrollment (per-batch)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batchLeads      BatchLead[]
}

// ============================================================
// BatchLead — per-batch enrollment leads from Google Forms
// ============================================================
// Each batch has its own Google Form with a per-batch Apps Script.
// When someone fills the form, the script sends the lead to
// /api/crm/batch-webhook with the batchId. The lead is saved here
// and visible only on that batch's "Leads" tab in the admin.
model BatchLead {
  id                 String   @id @default(cuid())
  batchId            String
  batch              TrainingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // ── Form fields (the 5 questions on the Google Form) ──
  name               String
  whatsappNumber     String              // with country code
  linkedinProfile    String?             // LinkedIn URL
  professionalStatus String?             // Student | Working Professional | Freelancer | Job Seeker | Other
  jobRole            String?             // current designation
  // ── Admin pipeline ──
  status             String   @default("New") // New | Contacted | Qualified | Enrolled | Lost
  adminNotes         String?
  source             String   @default("Google Form")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// EVENTS — public workshops/webinars/CTFs/campus programs (master-prompt §36)
// ============================================================
model Event {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @default("")
  longDescription String   @default("")
  type            String   @default("workshop")  // workshop | webinar | ctf | campus | awareness | corporate | bootcamp
  category        String   @default("General")
  startDate       String   @default("")          // display string e.g. "October 15, 2026"
  startIsoDate    String?                         // ISO date for sorting
  endDate         String   @default("")
  time            String   @default("")          // e.g. "7:00 PM - 9:00 PM IST"
  venue           String   @default("Online")   // venue or "Online"
  mode            String   @default("Live Online") // Live Online | On-Campus | Hybrid
  organizer       String   @default("GuardianX")
  instructor      String?                          // optional instructor name
  capacity        Int      @default(100)
  registered      Int      @default(0)
  fee             String   @default("Free")       // "Free" | "₹500" | "$50" etc.
  status          String   @default("Open")      // Open | Full | Completed | Cancelled
  imageUrl        String?                          // optional event banner
  tags            String   @default("")          // pipe-separated tags
  featured        Boolean  @default(false)
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================

// ============================================================
// PAYMENT-COUPON-SEARCH — Razorpay orders + coupon/discount system
// ============================================================
model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  batchId     String?
  amount      Float    // in INR
  currency    String   @default("INR")
  status      String   @default("created") // created | paid | failed | refunded
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature  String?
  couponCode  String?
  discount    Float    @default(0)
  finalAmount Float    @default(0)
  // What this order is for — used by the quiz-cert flow to know it's a quiz payment
  purpose       String  @default("COURSE") // COURSE | QUIZ_CERT
  quizAttemptId String? // linked QuizAttempt (when purpose = QUIZ_CERT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([purpose])
  @@index([quizAttemptId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("percentage") // percentage | fixed
  value       Float    // 10 = 10% off, or 500 = ₹500 off
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  validFrom   DateTime
  validUntil  DateTime?
  courseId    String?  // null = all courses
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// BATCH-3-FEATURES — Blog / Content Hub + Audit Log
// ============================================================
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String   @default("") // markdown
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  category    String   @default("General") // Threat Analysis | How-To | Certification Tips | Industry News
  tags        String   @default("")
  thumbnail   String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String   @default("")
  action     String   // e.g. "course.create", "user.delete", "coupon.create"
  resource   String   @default("") // e.g. "Course", "User", "Coupon"
  resourceId String? @default("")
  details    String   @default("") // JSON string with before/after
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// BATCH-5-FEATURES — Affiliate Program + Subscription Plans
// ============================================================
model Affiliate {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String   @unique // unique referral code
  commissionRate Float    @default(10) // percentage
  clicks         Int      @default(0)
  signups        Int      @default(0)
  conversions    Int      @default(0)
  earnings       Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  clicksLog      AffiliateClick[]
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ip          String   @default("")
  userAgent   String   @default("")
  courseId    String?
  createdAt   DateTime @default(now())
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   // Free, Pro, Enterprise
  price       Float    @default(0) // monthly price in INR
  features    String   @default("[]") // JSON array of feature strings
  popular     Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// PlatformSetting — admin-configurable keys/secrets stored in the DB
// ============================================================
// Stores Razorpay keys, SMTP settings, CRM webhook token, Sentry DSN,
// Google OAuth keys, etc. The admin enters these via the Platform
// Settings page — no need to touch Vercel env vars for most settings.
// The getSetting() helper reads from here first, falls back to env vars.
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique  // "RAZORPAY_KEY_ID", "SMTP_HOST", etc.
  value     String             // the actual value
  category  String             // "payment" | "email" | "crm" | "tracking" | "auth"
  isSecret  Boolean  @default(false)  // masks value in UI
  updatedAt DateTime @updatedAt
}

// ============================================================
// VerificationToken — one-time tokens for the Email (magic link)
// login provider (next-auth EmailProvider REQUIRES an adapter
// that can store these — see src/lib/auth-adapter.ts).
// ============================================================
// next-auth stores the token already hashed (HMAC with the auth
// secret), so rows are safe to keep in the DB. Tokens are single
// use: useVerificationToken() deletes the row on read. Rows are
// self-cleaning — expired ones are purged opportunistically when
// a new token is created.
model VerificationToken {
  identifier String   // the email the token was issued for
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Referral Program — referral-program-1
// ============================================================
// Enrolled students share a unique referral link. When someone
// enrolls via their link, both parties receive a discount coupon.
model Referral {
  id             String   @id @default(cuid())
  referrerId     String   // the student who shared the link
  referrer       User     @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredEmail  String?  // email of the person who was referred (null until they sign up)
  referredUserId String?  // user ID of the referred person (null until they enroll)
  status         String   @default("PENDING") // PENDING | ENROLLED | REWARDED | EXPIRED
  couponCode     String?  // the coupon code generated as reward
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([referrerId])
  @@index([referredEmail])
}

// ============================================================
// AUDIT FIXES — models that were referenced by API routes but
// missing from the schema (caused silent runtime 500s / empty
// responses because next.config.ts had ignoreBuildErrors: true).
// ============================================================

// --- Hands-on lab sessions (Docker-backed labs) ---
// Powers /api/labs/[slug]/orchestrate + /api/lab-sessions.
model LabSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId             String
  lab               Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  status            String    @default("starting") // starting | running | stopped | expired | error
  ttlMinutes        Int       @default(60)
  expiresAt         DateTime?
  targetContainerId String?
  attackContainerId String?
  targetIp          String?
  attackIp          String?
  sessionIp         String?   // simulated-session target IP (simulation mode)
  sessionPort       String?   // simulated-session port (simulation mode)
  networkName       String?
  dynamicFlag       String?   // per-session flag — NEVER returned to the browser
  terminalToken     String?   // signed WebSocket token for terminal-gateway
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([labId, status])
  @@index([expiresAt])
}

// --- Mock exams ---
model MockExam {
  id          String   @id @default(cuid())
