// GuardianX LMS — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN | SUPER_ADMIN | PROCTOR | SCHOOL_ADMIN | INSTITUTION_ADMIN
  avatar        String?
  bio           String?
  title         String? // e.g. "Senior Security Engineer"
  phone         String? // contact phone (any role) — editable via profile UI
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD for streak tracking
  schoolId      String? // linked school (for school-admin / school students)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments     Enrollment[]
  progress        LessonProgress[]
  notes           Note[]
  quizAttempts    QuizAttempt[]
  taughtCourses   Course[]
  labProgress     LabProgress[]
  certificates    Certificate[]
  liveSessionsHost LiveSession[] @relation("hostedSessions")
  liveSessionMembers LiveSessionMember[]
  discussions     Discussion[]
  replies         DiscussionReply[]
  achievements    UserAchievement[]
  activities      UserActivity[]
  notifications   Notification[]
  reviews         CourseReview[]
  bookmarks       Bookmark[]
  // New relations
  assignmentsCreated   Assignment[]
  submissions          AssignmentSubmission[]
  rubricsCreated       GradingRubric[]
  officeHourSlots      OfficeHourSlot[]
  officeHourBookings   OfficeHourBooking[]
  messageThreadsA      MessageThread[] @relation("threadUserA")
  messageThreadsB      MessageThread[] @relation("threadUserB")
  messages             Message[]
  studyGroupsCreated   StudyGroup[]
  studyGroupMemberships StudyGroupMember[]
  peerReviewsGiven     PeerReview[]
  peerReviewsReceived  PeerReview[] @relation("reviewedSubmissions")
  attendanceRecords    AttendanceRecord[]
  emailsReceived       EmailLog[]
  schoolMemberships    SchoolMember[]
  batchMemberships     BatchMember[]
  // Feature expansion relations
  aiChatSessions       AIChatSession[]
  codeReviews          CodeReview[]
  careerPaths          CareerPath[]
  postedJobs           Job[]
  jobApplications      JobApplication[]
  mockInterviews       MockInterview[]
  resumes              Resume[]
  ctfOrganized         CTFCompetition[]
  ctfTeamMemberships   CTFTeamMember[]
  weeklyChallengeSubs  WeeklyChallengeSubmission[]
  teamMissionMemberships TeamMissionMember[]
  learningAnalytics    LearningAnalytics[]
  skillAssessmentResults SkillAssessmentResult[]
  labSnapshots         LabSnapshot[]
  cyberRangeMemberships CyberRangeMember[]
  bugBountySubmissions  BugBountySubmission[]
  parentAccounts       ParentAccount[]
  labSessions          LabSession[]
  mockExamAttempts     MockExamAttempt[]
  authoredCourses      AuthoredCourse[]
  instructorProfile    InstructorProfile?
  leadNotes            LeadNote[]
  // Payment + coupon relations (PAYMENT-COUPON-SEARCH feature)
  orders               Order[]
  // Blog posts authored by this user (BATCH-3-FEATURES — Blog/Content Hub)
  blogPosts            BlogPost[]
  // Affiliate program — one affiliate record per user (BATCH-5-FEATURES)
  affiliate            Affiliate?
  // Referral program — referrals created by this user (referral-program-1)
  referrals            Referral[] @relation("referrer")
}

// ============================================================
// School / Institution model — multi-tenant schools, colleges, universities
// ============================================================
model School {
  id            String   @id @default(cuid())
  schoolCode    String   @unique // e.g. "GXS-DELHI-001" — used for institution login
  name          String
  type          String   @default("SCHOOL") // SCHOOL | COLLEGE | UNIVERSITY
  email         String?  // contact email
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String   @default("India")
  logoUrl       String?
  website       String?
  // School admin credentials (the person who logs in via the School Portal tab)
  adminName     String
  adminEmail    String   @unique
  passwordHash  String
  status        String   @default("active") // active | suspended | pending
  maxStudents   Int      @default(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       SchoolMember[]
  batches       Batch[]
}

model SchoolMember {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   @default("STUDENT") // STUDENT | INSTRUCTOR | SCHOOL_ADMIN
  joinedAt      DateTime @default(now())

  @@unique([schoolId, userId])
}

// ============================================================
// Open Schooling — lead-capture for 10th & 12th registration
// ============================================================
// Students who want to complete 10th (Secondary) or 12th (Senior Secondary)
// through open schooling register interest via the public "Open Schooling"
// tab. Admins follow up to complete the actual registration, collect
// documents, and take payment manually.
model OpenSchoolingLead {
  id             String   @id @default(cuid())
  // Personal details
  name           String
  email          String
  phone          String
  dateOfBirth    String?  // YYYY-MM-DD (collected for eligibility check)
  // Course interest
  course         String   // "10th" | "12th"
  city           String?
  state          String?
  qualification   String?  // previous education (e.g. "8th pass", "10th pass", "B.Com")
  // Optional message from the student
  message        String?
  // Lead pipeline status — managed by admins
  status         String   @default("NEW") // NEW | CONTACTED | ENROLLED | LOST
  adminNotes     String?  // internal notes set by admins
  // Metadata
  source         String   @default("WEBSITE") // WEBSITE | WHATSAPP | REFERRAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([course])
  @@index([createdAt])
}

// ============================================================
// Corporate Training — lead-capture for B2B cyber training inquiries
// ============================================================
// Companies that want custom cyber security training for their teams
// (SOC, IT, GRC, Leadership) submit a lead via the public "Corporate
// Training" page. Admins follow up to scope the engagement, propose a
// custom curriculum, and quote a price.
model CorporateLead {
  id               String   @id @default(cuid())
  // Company details
  companyName      String
  // Contact person
  contactName      String
  workEmail        String
  phone            String
  // Requirements
  teamSize         String   // "1-10" | "11-50" | "51-200" | "200+"
  trainingInterest String   // comma-separated: "SOC,IT,GRC,Leadership,Custom,NotSure"
  timeline         String?  // "immediate" | "1-3 months" | "exploring"
  // Optional message
  message          String?
  // Lead pipeline — managed by admins
  status           String   @default("NEW") // NEW | CONTACTED | CONVERTED | LOST
  adminNotes       String?
  // Metadata
  source           String   @default("WEBSITE") // WEBSITE | REFERRAL | PARTNER
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([companyName])
  @@index([createdAt])
}

// ============================================================
// Cyber Security Foundation Quiz — public quiz + paid certificate
// ============================================================
// 100-question pool across 8 categories. Candidates pick difficulty
// (Easy/Hard/Advanced), get 30 random questions, must score ≥50% to pass.
// On pass + ₹199 payment, a verifiable certificate + progress report
// auto-generate.

model QuizQuestion {
  id            String   @id @default(cuid())
  category      String   // Phishing | Passwords | Social Engineering | Web Safety | Mobile Security | Data Privacy | Malware | Wi-Fi Safety
  difficulty    String   // Easy | Hard | Advanced
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // A | B | C | D
  explanation   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([active])
}

model CyberQuizAttempt {
  id             String   @id @default(cuid())
  userId         String?  // null for guest attempts before payment
  guestEmail     String?
  guestName      String?
  difficulty     String   // Easy | Hard | Advanced (candidate-selected)
  questionIds    String   // JSON array of 30 question IDs shown
  answers        String   // JSON array of { questionId, selected }
  score          Int      // correct count
  totalQuestions Int      // 30
  percentage     Int      // 0-100
  passed         Boolean  // percentage >= 50
  // Per-category breakdown for the progress report
  domainScores   String?  // JSON: { "Phishing": { correct: 3, total: 4 }, ... }
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  certificateId  String?  // linked CyberQuizCertificate.credentialId after payment
  certificate    CyberQuizCertificate?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([passed])
  @@index([createdAt])
}

model CyberQuizCertificate {
  id               String   @id @default(cuid())
  credentialId     String   @unique // GX-QUIZ-YYYY-XXXX format
  attemptId        String   @unique
  attempt          CyberQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  orderId          String?  // linked Order (the ₹199 payment)
  candidateName    String
  email            String
  difficulty       String   // Easy | Hard | Advanced
  score            Int      // correct count
  totalQuestions   Int      // 30
  percentage       Int      // 0-100
  domainScores     String   // JSON: per-category breakdown for the progress report
  issueDate        DateTime @default(now())
  verificationHash String   @unique
  verificationUrl  String?
  status           String   @default("valid") // valid | revoked
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([credentialId])
}

model Batch {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   // e.g. "Batch 2024-A"
  courseIds     String   @default("") // comma-separated course IDs assigned to this batch
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active") // active | completed | archived
  createdAt     DateTime @default(now())

  members       BatchMember[]
}

model BatchMember {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt    DateTime @default(now())

  @@unique([batchId, userId])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. FIRST_LAB, STREAK_7
  title       String
  description String
  icon        String   @default("award") // lucide icon name
  color       String   @default("emerald")
  xp          Int      @default(50)
  tier        String   @default("bronze") // bronze | silver | gold | platinum
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // lesson_completed | lab_solved | quiz_passed | note_created | course_enrolled | cert_earned
  xp          Int      @default(0)
  meta        String   @default("") // JSON-ish metadata
  date        String   // YYYY-MM-DD (for daily aggregation / streaks)
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortName     String // e.g. "CEH"
  description   String
  longDescription String
  category      String // Certification / Networking / Cloud Security / etc.
  vertical     String   @default("cyber") // cyber | ai | cloud
  level         String // Beginner | Intermediate | Advanced
  durationHours Int      @default(40)
  price         Float    @default(0)
  rating        Float    @default(4.5)
  studentsCount Int      @default(0)
  thumbnail     String?
  color         String   @default("emerald") // theme accent
  tags          String   @default("") // comma separated
  certBody      String? // e.g. "EC-Council"
  published     Boolean  @default(true)
  prerequisiteIds String @default("") // comma-separated course IDs (Course Prerequisites feature)
  certificateTemplateId String? // optional template override
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id])

  modules       Module[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  discussions   Discussion[]
  labs          Lab[]
  liveSessions  LiveSession[]
  reviews       CourseReview[]
  bookmarks     Bookmark[]
  // New relations
  assignments   Assignment[]
  rubrics       GradingRubric[]
  attendanceRecords AttendanceRecord[]
  studyGroups   StudyGroup[]
  officeHourSlots OfficeHourSlot[]
  // Payment relations (PAYMENT-COUPON-SEARCH feature)
  orders        Order[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  type        String   @default("reading") // reading | pdf | video | lab
  content     String   @default("") // markdown / html text content
  pdfUrl      String?
  pdfPages    Int      @default(0)
  durationMin Int      @default(15)
  order       Int      @default(0)
  preview     Boolean  @default(false) // free preview

  progress    LessonProgress[]
  notes       Note[]
  quiz        Quiz?
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Float    @default(0) // percentage 0-100
  completed   Boolean  @default(false)
  enrolledAt  DateTime @default(now())
  lastAccessed DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  position    Int      @default(0) // pdf page or video position
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String?
  title       String   @default("Untitled note")
  content     String   @default("")
  color       String   @default("default")
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quiz {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  options     String   @default("") // pipe separated options
  answerIndex Int      @default(0)
  explanation String?
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int      @default(0) // percentage
  answers     String   @default("[]") // JSON
  passed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateId String @unique
  issuedAt    DateTime @default(now())
  score       Int      @default(0)
  templateId  String?
  template    CertificateTemplate? @relation("certificateTemplate", fields: [templateId], references: [id])
  verificationHash String? // tamper-evident hash for verification
}

model Lab {
  id            String   @id @default(cuid())
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  title         String
  slug          String   @unique
  description   String
  longDescription String
  category      String // Web Security | Network | Privilege Escalation | Cryptography | Forensics | Reverse Engineering
  difficulty    String   @default("Easy") // Easy | Medium | Hard | Insane
  durationMin   Int      @default(30)
  points        Int      @default(100)
  tags          String   @default("")
  scenario      String   @default("") // markdown scenario/instructions
  objectives    String   @default("") // pipe separated objectives
  hints         String   @default("") // pipe separated hints
  flag          String   @default("FLAG{}") // CTF flag
  commands      String   @default("") // pipe separated available commands
  virtualEnv    String   @default("linux") // simulated env type
  color         String   @default("emerald")
  published     Boolean  @default(true)
  autoGrade     Boolean  @default(true) // auto-grade submission when flag matches
  xpReward      Int      @default(100) // XP awarded on completion
  passingScore  Int      @default(100) // minimum score to pass (auto-graded labs)
  createdAt     DateTime @default(now())

  progress      LabProgress[]
  sessions      LabSession[]
  snapshots     LabSnapshot[]
}

model LabProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  status      String   @default("not_started") // not_started | in_progress | completed
  flagFound   Boolean  @default(false)
  hintsUsed    Int      @default(0)
  timeSpentMs Int      @default(0) // cumulative time spent in the lab terminal (ms)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, labId])
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  description String?
  hostId      String
  host        User     @relation("hostedSessions", fields: [hostId], references: [id])
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  roomId      String   @unique // socket.io room
  status      String   @default("scheduled") // scheduled | live | ended
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  maxStudents Int      @default(50)
  createdAt   DateTime @default(now())

  members     LiveSessionMember[]
}

model LiveSessionMember {
  id          String   @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("viewer") // host | cohost | viewer
  canShare    Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@unique([sessionId, userId])
}

model Discussion {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  replies     DiscussionReply[]
}

model DiscussionReply {
  id          String   @id @default(cuid())
  discussionId String
  discussion  Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // achievement | level_up | course_update | live_start | reply | streak | welcome | certificate
  title       String
  message     String
  icon        String   @default("bell") // lucide icon name
  color       String   @default("emerald")
  link        String?  // optional view target, JSON-encoded e.g. {"name":"achievements"}
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model CourseReview {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5 stars
  title       String   @default("")
  content     String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}

// ============================================================
// NEW MODELS — GuardianX Academy feature expansion
// ============================================================

// --- Assignment System + Grading Rubric + Peer Review ---
model Assignment {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId      String?  // optional module link
  title         String
  description   String   @default("")
  instructions  String   @default("") // markdown
  pointsPossible Int     @default(100)
  dueDate       DateTime
  allowLate     Boolean  @default(true)
  latePenalty   Int      @default(10) // percent per day
  submissionType String  @default("text") // text | file | url
  enablePeerReview Boolean @default(false)
  peerReviewCount Int    @default(2) // how many peers review each submission
  peerReviewDueDate DateTime?
  rubricId      String?
  rubric        GradingRubric? @relation("assignmentRubric", fields: [rubricId], references: [id])
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions   AssignmentSubmission[]
  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id])
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String   @default("") // text submission
  fileUrl       String?  // file or URL submission
  submittedAt   DateTime @default(now())
  late          Boolean  @default(false)
  grade         Int?     // final grade 0-100
  gradedAt      DateTime?
  gradedBy      String?
  feedback      String   @default("") // instructor feedback
  rubricScores  String   @default("[]") // JSON array of per-criterion scores
  status        String   @default("submitted") // submitted | graded | returned | resubmitted

  peerReviews   PeerReview[]

  @@unique([assignmentId, userId])
}

model GradingRubric {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  createdBy     String
  creator       User     @relation(fields: [createdBy], references: [id])
  criteria      RubricCriterion[]
  assignments   Assignment[] @relation("assignmentRubric")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RubricCriterion {
  id            String   @id @default(cuid())
  rubricId      String
  rubric        GradingRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  label         String   // e.g. "Technical Accuracy"
  description   String   @default("")
  points        Int      @default(25) // max points for this criterion
  order         Int      @default(0)
}

model PeerReview {
  id            String   @id @default(cuid())
