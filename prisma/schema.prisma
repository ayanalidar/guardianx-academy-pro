// --- GRC (Governance / Risk / Compliance) content ---
model GrcContent {
  id               String   @id @default(cuid())
  title            String
  category         String   @default("Governance") // Governance | Risk | Compliance
  summary          String   @default("")
  content          String   @default("") // markdown body
  framework        String   @default("") // e.g. "ISO 27001", "NIST CSF"
  icon             String   @default("shield")
  color            String   @default("emerald")
  relatedCourseIds String   @default("[]") // JSON array of course ids
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, order])
}

// --- Sentinel (SOAR) — security incidents / events / automated actions ---
model Incident {
  id          String   @id @default(cuid())
  title       String
  component   String   @default("unknown") // api | auth | database | labs | payments | ...
  severity    String   @default("warning") // info | warning | critical
  status      String   @default("open") // open | investigating | resolved | dismissed
  description String?
  evidence    String   @default("[]") // JSON array of evidence items
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([detectedAt])
}

model SystemEvent {
  id        String   @id @default(cuid())
  level     String   @default("info") // info | warn | error
  source    String   @default("system") // api | worker | orchestrator | auth | ...
  message   String
  meta      String   @default("{}") // JSON metadata
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([level])
}

model SentinelAction {
  id          String   @id @default(cuid())
  action      String // e.g. "block-ip" | "quarantine-session" | "rotate-secret"
  target      String   @default("") // what the action was applied to
  status      String   @default("completed") // pending | completed | failed | reverted
  performedBy String   @default("sentinel") // sentinel | <admin user id>
  details     String   @default("{}") // JSON metadata
  timestamp   DateTime @default(now())

  @@index([timestamp])
}

// ============================================================
// SETTINGS-FIXES — Invoice persistence for the Invoice Generator
// (Admin → Invoice Generator). Previously invoices were only kept
// in React state and were lost on refresh; the mini dashboard had
// no real data. Admin-only CRUD via /api/invoices.
// ============================================================
model Invoice {
  id              String   @id @default(cuid())
  number          String   @unique // e.g. "GX-INV-2026-0042"
  clientName      String
  clientOrg       String?
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?
  items           String   @default("[]") // JSON: [{description, quantity, unitPrice, icon}]
  currency        String   @default("INR") // INR | USD | EUR | GBP
  discountRate    Float    @default(0)     // percent 0-100
  taxRate         Float    @default(0)     // percent 0-100
  gstSplit        Boolean  @default(false) // CGST/SGST display split (INR)
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)
  roundingAdjustment Float @default(0)
  status          String   @default("Draft") // Draft | Sent | Paid | Overdue
  issueDate       String   @default("")      // ISO date "YYYY-MM-DD"
  dueDate         String?
  notes           String?
  terms           String?
  bankName        String?
  accountName     String?
  accountNumber   String?
  ifscCode        String?
  upiId           String?
  createdById     String?  // admin who created it (no FK — plain id like ProctoringSession.userId)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
