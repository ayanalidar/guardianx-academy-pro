model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  organization  String?
  type          String   @default("Individual") // Individual | School | College | University | Corporate | Partner | Workshop | CTF | Webinar
  status        String   @default("New") // New | Contacted | Qualified | Proposal | Negotiation | Converted | Lost
  source        String   @default("Contact Form") // Google Form | Contact Form | Manual | Referral
  score         Int      @default(0) // 0-100 lead score
