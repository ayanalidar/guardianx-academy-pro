# GuardianX Academy — environment variables.
#
# Copy this file to `.env` (locally) or set the same keys in your Vercel
# project settings (for production). Never commit a real `.env` file.
#
# Generate strong secrets with:
#   openssl rand -base64 32

# ============================================================================
# REQUIRED — app won't boot without these
# ============================================================================

# PostgreSQL connection string. Use Neon, Supabase, RDS, or any managed PG.
# Include ?sslmode=require for cloud providers.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth JWT signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-base64-string"

# Public URL of the deployed app. Local dev: http://localhost:3000
# Production: https://academy.guardianx.cloud
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# OPTIONAL — payment (Razorpay). Without these, payment verify refuses to
# verify (set PAYMENT_MOCK_MODE=true for local dev only).
# ============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set to "true" ONLY in local dev. Refuses to verify in production.
PAYMENT_MOCK_MODE="false"

# ============================================================================
# OPTIONAL — Google OAuth. Without these, "Sign in with Google" is hidden.
# ============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================================
# OPTIONAL — SMTP for transactional + magic-link emails.
# Without these, magic-link login is silently disabled.
# ============================================================================
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ============================================================================
# OPTIONAL — Sentry error tracking.
# ============================================================================
SENTRY_DSN=""

# ============================================================================
# OPTIONAL — Prisma dev logging. Set to "1" to log every query.
# ============================================================================
# PRISMA_LOG_QUERIES="1"

# ============================================================================
# OPTIONAL — AI assistant (z-ai-web-dev-sdk).
# ============================================================================
# Z_AI_API_KEY=""

# ============================================================================
# OPTIONAL — Vercel Blob (for upload storage).
# ============================================================================
# BLOB_READ_WRITE_TOKEN=""

# ============================================================================
# Docker / lab orchestrator — set automatically in docker-compose.yml.
# Local dev: leave unset (lab orchestrator runs in simulation mode).
# ============================================================================
# DOCKER_AVAILABLE=""
# DOCKER_HOST=""
